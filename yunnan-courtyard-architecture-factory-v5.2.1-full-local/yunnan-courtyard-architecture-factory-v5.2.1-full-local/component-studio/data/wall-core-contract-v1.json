{
  "schemaVersion": "1.0.0",
  "recordId": "YUNNAN-WALL-CORE-OPENING-CONTRACT-V1",
  "studioVersion": "2.9.0",
  "scope": "independent wall core width, wall batter, door-frame closure and deep-brown earthen body",
  "geometryContract": {
    "coreSegments": ["left-lower-pier", "right-lower-pier", "upper-header-wall"],
    "requiredClosedSegments": 3,
    "openSurfaceCount": 0,
    "doorOpeningSource": "door clear width plus frame section minus adjustable masonry overlap",
    "frameRelationship": "wall core overlaps the timber frame by closureOverlap and the lintel embeds into both piers",
