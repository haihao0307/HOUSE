    },
    {
      "id": "L05",
      "name": "地基与墙脚",
      "question": "木柱和厚墙分别如何落地、防潮和适应地形？",
      "output": "基础、柱础、石勒脚和地面层"
    },
    {
      "id": "L06",
      "name": "一层平面",
      "question": "堂屋、卧室、厨房、畜厩、入口和天井如何组织？",
      "output": "房间、门洞、交通和排水边界"
    },
    {
      "id": "L07",
      "name": "楼面与二层",
      "question": "楼梯、楼板、祖堂、储藏和居室如何叠合？",
      "output": "楼面支承和二层功能图"
    },
    {
      "id": "L08",
      "name": "立面等级",
      "question": "主房、耳房、倒座、门楼的檐口、屋脊和开口等级如何？",
      "output": "外立面与院内立面控制线"
    },
    {
      "id": "L09",
      "name": "控制剖面",
      "question": "层高、檩位、出檐、廊厦和屋脊如何连接？",
      "output": "标高账本和支承关系"
    },
    {
      "id": "L10",
      "name": "木构装配",
      "question": "柱、枋、梁、楼袱、檩、椽按什么顺序装配？",
      "output": "构件树和节点接口"
    },
    {
      "id": "L11",
      "name": "屋面与瓦作",
      "question": "每片坡面向哪里排水，瓦片怎样搭接与收边？",
      "output": "独立屋面、瓦行、脊与檐口"
    },
    {
      "id": "L12",
      "name": "门窗运动",
      "question": "洞口、框、扇、转轴、开启范围和碰撞关系是否明确？",
      "output": "可开启门窗状态机"
    },
    {
      "id": "L13",
      "name": "历史状态",
      "question": "1940—1945年的材料、损伤、修补和后加建是什么？",
      "output": "可回滚的年代增量层"
    },
    {
      "id": "L14",
      "name": "三维装配与验收",
      "question": "每个三维构件能否追溯到平面、剖面和证据？",
      "output": "可审计模型与质量报告"
    }
  ],
  "sharedPlanGrammar": {
    "terms": {
      "坊房": "独立的条形房屋单元，可由三间或其他离散间数组成。",
      "间": "相邻构架轴之间的结构与空间模数；三间对应四条构架轴。",
      "步架": "沿进深方向由柱列、梁架和檩位形成的结构段。",
      "院落": "由坊房、照壁、倒座或围墙围合的室外核心空间。",
      "厦子或廊厦": "主体房屋檐下的附属交通与活动空间，必须有独立柱位和屋面。",
      "照壁": "入口侧的空间界面，其承重角色必须单独注明。",
      "倒座": "位于主房对侧的入口或服务建筑段，地方术语与尺寸须按个案解释。"
    },
    "rules": [
      "院落单元由离散房屋组合形成，禁止把整体包络连续拉伸为新类型。",
      "主体房屋的间数决定面阔轴数；墙和门窗必须挂接到轴间。",
      "主房、侧房和入口建筑分别生成，屋面不得由一个整体网格覆盖。",
      "楼梯必须连接明确的楼面标高和交通节点。",
      "天井与院落必须保存地面坡向、暗沟或明沟及汇水目标。",
      "外墙开口和院内开口分别建模，以表达外闭内开的空间性格。"
    ]
  },
