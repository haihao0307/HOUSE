{
  "schemaVersion": "5.3.0",
  "id": "YUNNAN-HISTORICAL-BUILDING-PLAN-FIRST-PIPELINE",
  "title": "云南历史民居平面优先生产管线",
  "principles": [
    {
      "id": "PR-01",
      "name": "图证优先",
      "rule": "所有类型、尺寸、材料、节点和历史状态都必须引用来源。缺少来源时保留未知状态。"
    },
    {
      "id": "PR-02",
      "name": "平面优先",
      "rule": "院落拓扑、单体边界、间架轴网、一层平面和门窗宿主关系通过以后，才能进入楼层、剖面、木构架和屋面。"
    },
    {
      "id": "PR-03",
      "name": "逐层生成",
      "rule": "地坪、基础、柱础、柱网、墙体、楼面、二层、屋架、瓦作和装饰严格按依赖顺序生成。"
    },
    {
      "id": "PR-04",
      "name": "离散类型",
      "rule": "间数、耳房数量、坊数和院落数量采用离散类型操作，禁止通过连续拉伸替代真实构造变化。"
    },
    {
      "id": "PR-05",
      "name": "活动构件",
      "rule": "门窗必须拥有宿主墙、洞口、框、扇、枢轴、角度范围、状态机和碰撞检查。"
    },
    {
      "id": "PR-06",
      "name": "瓦作锁定",
      "rule": "在瓦片截面、搭接、行距、檐口和脊部证据未齐全以前，不生成写实瓦片几何。"
    },
    {
      "id": "PR-07",
      "name": "解释与几何分层",
      "rule": "环境、礼制、功能和历史谱系分别登记置信度，解释性主张不能自动改变几何。"
    },
    {
      "id": "PR-08",
      "name": "版本可回滚",
      "rule": "原始证据、测绘值、推导值、生成值和人工修订值分别保存，任何校准都以增量形式记录。"
    }
  ],
  "phases": [
    {
      "id": "P00",
      "name": "证据封存",
      "inputs": [
        "用户图片",
        "测绘图",
        "学术文献",
        "模型",
        "现场照片"
      ],
      "tasks": [
        "记录来源、作者、时间和许可",
        "计算文件哈希",
        "区分直接观察与解释性文字",
        "登记不能推导的内容"
      ],
      "outputs": [
        "sourceManifest",
        "claimRegistry",
        "uncertaintyRegister"
      ],
      "gate": "每一条生成规则都有来源或明确未知标记"
    },
    {
      "id": "P01",
      "name": "地区与形成条件",
      "inputs": [
        "地形",
        "气候",
        "水系",
        "地震",
        "材料",
        "家庭与生产方式"
      ],
      "tasks": [
        "建立地区环境驱动",
        "建立功能与文化驱动",
        "区分区域共性与个案差异"
      ],
      "outputs": [
        "regionalDrivers"
      ],
      "gate": "环境解释不直接替代建筑图证"
    },
    {
      "id": "P02",
      "name": "类型家族",
      "inputs": [
        "类型名称",
        "平面示意",
        "地方术语"
      ],
      "tasks": [
        "定义基本单元",
        "定义合法增减操作",
        "定义典型型、过渡型和复合型"
      ],
      "outputs": [
        "typeFamilyGrammar"
      ],
      "gate": "类型变化可以用离散操作表达"
    },
    {
      "id": "P03",
      "name": "场地基准",
      "inputs": [
        "用地边界",
        "北向",
        "主轴",
        "地坪",
        "坡度",
        "临街与水系"
      ],
      "tasks": [
        "建立局部坐标系",
        "设置主轴和地坪零点",
        "保存场地高差和排水方向"
      ],
      "outputs": [
        "siteDatum"
      ],
      "gate": "所有单体坐标都可回溯到统一基准"
    },
    {
      "id": "P04",
      "name": "院落拓扑",
      "inputs": [
        "类型家族",
        "场地基准"
      ],
      "tasks": [
        "放置正房或主坊",
        "放置耳房或侧坊",
        "放置倒座或照壁",
        "确定天井和漏角"
      ],
      "outputs": [
        "compoundTopology"
      ],
      "gate": "单体互不重叠，入口、主轴和院落闭合关系明确"
    },
    {
      "id": "P05",
      "name": "间架与轴网",
      "inputs": [
        "单体边界",
        "面阔间数",
        "进深步架"
      ],
      "tasks": [
        "建立面阔轴",
        "建立进深轴",
        "标记明间、次间、梢间",
        "生成柱位候选"
      ],
      "outputs": [
        "bayGrid",
        "depthGrid",
        "columnCandidates"
      ],
      "gate": "三间对应四条构架轴，五间对应六条构架轴"
    },
    {
      "id": "P06",
      "name": "地基与墙脚",
      "inputs": [
        "轴网",
        "墙体体系",
        "地面材料"
      ],
      "tasks": [
        "确定基础沟槽或独立柱础",
        "生成毛石勒脚或石基",
        "区分木柱支承与围护墙基础"
      ],
      "outputs": [
        "foundationPlan",
        "plinthPlan"
      ],
      "gate": "柱、墙和地面的支承路径分别明确"
    },
    {
      "id": "P07",
      "name": "一层语义平面",
      "inputs": [
        "院落拓扑",
        "轴网",
        "基础"
      ],
      "tasks": [
        "划分房间",
        "分配堂屋、厨房、畜廊、储藏和交通",
        "标记廊厦和天井"
      ],
      "outputs": [
        "groundFloorPlan"
      ],
      "gate": "每个空间拥有边界、用途、层级和相邻关系"
    },
    {
      "id": "P08",
      "name": "开口与活动构件",
      "inputs": [
        "一层平面",
        "墙段"
      ],
      "tasks": [
        "确定门窗宿主墙",
        "建立洞口和框扇",
        "设置枢轴与开启角",
        "进行碰撞检查"
      ],
      "outputs": [
        "openingAssemblies"
      ],
      "gate": "门窗可以执行开启、关闭和锁定状态"
    },
    {
      "id": "P09",
      "name": "一层木构与围护",
      "inputs": [
        "柱位",
        "开口",
        "墙体体系"
      ],
      "tasks": [
        "生成柱础、柱、穿枋、梁枋",
        "生成土墙、砖包土墙或填充墙",
        "保持承重与围护分层"
      ],
      "outputs": [
        "groundFrame",
        "groundEnclosure"
      ],
      "gate": "构架荷载路径连续，墙体不冒充木构架"
    },
    {
      "id": "P10",
      "name": "楼面与二层平面",
      "inputs": [
        "一层木构",
        "楼梯",
        "垂直功能"
      ],
      "tasks": [
        "生成楼袱、楼楞和楼板",
        "设置楼梯洞口",
        "绘制二层房间和廊道"
      ],
      "outputs": [
        "floorAssembly",
        "upperFloorPlan"
      ],
      "gate": "二层柱位与下部支承关系明确"
    },
    {
      "id": "P11",
      "name": "控制剖面",
      "inputs": [
        "两层平面",
        "层高",
        "廊厦",
        "屋面意向"
      ],
      "tasks": [
        "建立地坪、楼面、檐口、檩位和屋脊标高",
        "核对楼梯净高",
        "核对廊厦与正房关系"
      ],
      "outputs": [
        "sectionControl"
      ],
      "gate": "所有垂直标高来源和置信度明确"
    },
    {
      "id": "P12",
      "name": "上层木构架",
      "inputs": [
        "二层平面",
        "控制剖面"
      ],
      "tasks": [
        "生成上层柱、梁、枋",
        "生成封闭或敞廊边界",
        "生成阁楼候选"
      ],
      "outputs": [
        "upperFrame"
      ],
      "gate": "上层结构与楼面、屋架接口匹配"
    },
    {
      "id": "P13",
      "name": "屋架",
      "inputs": [
        "单体边界",
        "构架",
        "屋面类型",
        "剖面"
      ],
      "tasks": [
        "生成檐檩、中檩、脊檩",
        "生成椽子路径",
        "生成硬山或悬山山面",
        "检查各屋面是否非法相交"
      ],
      "outputs": [
        "roofFrame"
      ],
      "gate": "主建筑至少双坡，附属单坡必须有明确构造身份"
    },
    {
      "id": "P14",
      "name": "廊厦与檐口",
      "inputs": [
        "屋架",
        "廊厦类型"
      ],
      "tasks": [
        "生成厦柱、挑檐、腰檐和回廊",
        "核对环廊或前后廊交通",
        "核对排水滴落线"
      ],
      "outputs": [
        "galleryAssembly",
        "eaveAssembly"
      ],
      "gate": "廊厦类型和柱位有剖面依据"
    },
    {
      "id": "P15",
      "name": "瓦作",
      "inputs": [
        "屋架",
        "瓦片样本",
        "搭接规则",
        "脊部做法"
      ],
      "tasks": [
        "生成屋面基层",
        "生成阴阳瓦或板盖瓦",
        "生成檐口收边",
        "生成正脊、垂脊和装饰"
      ],
      "outputs": [
        "roofCovering"
      ],
      "gate": "瓦片截面、尺寸、搭接和行距齐全；缺一项则保持锁定"
    },
    {
      "id": "P16",
      "name": "排水与地面",
      "inputs": [
        "屋面坡向",
        "院落",
        "地坪高差"
      ],
      "tasks": [
        "计算雨落线",
        "生成天井坡向",
        "生成明沟或暗沟",
        "设置井、水缸或排水出口"
      ],
      "outputs": [
        "drainageGraph",
        "courtyardFloor"
      ],
      "gate": "每一片屋面都存在明确的排水去向"
    },
    {
      "id": "P17",
      "name": "装饰与地方构件",
      "inputs": [
        "结构完成模型",
        "地方构件证据"
      ],
      "tasks": [
        "添加照壁、悬鱼、瓦猫、门楼、麻雀台、金包玉等",
        "保存象征意义与几何来源"
      ],
      "outputs": [
        "regionalDetails"
      ],
      "gate": "装饰不改变未验证的主要结构"
    },
    {
      "id": "P18",
      "name": "三维装配",
      "inputs": [
        "已通过的全部二维和结构层"
      ],
      "tasks": [
        "按构件树生成三维",
        "保留可活动门窗",
        "生成分层显示和施工播放",
        "导出 glTF 中间数据"
      ],
      "outputs": [
        "sceneGraph",
        "gltfAssembly"
      ],
      "gate": "每个三维构件都可追溯到平面、剖面和证据"
    },
    {
      "id": "P19",
      "name": "历史状态与验收",
      "inputs": [
        "三维装配",
        "1940至1945年证据",
        "后期改建记录"
      ],
      "tasks": [
        "区分原构件、修补、损伤和后期加建",
        "运行拓扑、结构、屋面、排水和开口检查",
        "生成版本报告"
      ],
      "outputs": [
        "historicalState",
        "qaReport",
        "releaseManifest"
      ],
      "gate": "错误为零，提示项均有解释和回滚路径"
    }
  ],
  "compatibilityNote": "由 V4.0 详细规则层迁移并纳入 V5.2.1 当前稳定生产线，旧版渲染器与旧坐标实现不在本文件中。"
}
