uniform sampler2D stateTex;uniform float depthThreshold;out vec4 outState;
void main(){ivec2 xy=ivec2(gl_FragCoord.x,mod(gl_FragCoord.y,resolution.y)),size=ivec2(resolution);int layer=int(floor(gl_FragCoord.y/resolution.y));vec4 own=texelFetch(stateTex,xy,0);int count=0,closer=0;vec4 neighbor=vec4(0),fallback=vec4(0);ivec2 pick=layer==0?ivec2(-1,0):layer==1?ivec2(1,0):layer==2?ivec2(0,-1):ivec2(0,1);for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){if(x==0&&y==0)continue;ivec2 k=xy+ivec2(x,y);if(any(lessThan(k,ivec2(0)))||any(greaterThanEqual(k,size)))continue;vec4 n=texelFetch(stateTex,k,0);if(n.w>.5){count++;if(own.w>.5&&n.z<own.z-depthThreshold)closer++;if(fallback.w<.5)fallback=n;if(x==pick.x&&y==pick.y)neighbor=n;}}if(count<5||(own.w>.5&&(count<7||closer<4))){outState=vec4(0);return;}if(neighbor.w<.5)neighbor=fallback;neighbor.w=floor(neighbor.w);outState=neighbor;}
