path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')

# ---------------------------------------------------------------------------
# App and UI versioning.
# ---------------------------------------------------------------------------
path = ROOT / 'brick-mother-app-v2.js'
text = path.read_text(encoding='utf-8')
text = text.replace('2.2.0-alpha.1', '2.3.0-alpha.1')
text = text.replace("'1.1.0'", "'1.2.0'")
text = text.replace('V2.2', 'V2.3')
text = replace_once(
    text,
    '        oxideContourSuppression: true,\n        profileEvidenceRoute: state.evidenceMode,',
    '        oxideContourSuppression: true,\n        connectedColorNetworksSuppressed: true,\n        naturalStonePalette: true,\n        familySpecificSaturation: true,\n        profileEvidenceRoute: state.evidenceMode,',
    'app V2.3 QA flags'
)
path.write_text(text, encoding='utf-8')

path = ROOT / 'index.html'
text = path.read_text(encoding='utf-8')
text = text.replace('20260829-v22-calibration', '20260829-v23-natural-events')
text = text.replace('V2.2 MATERIAL CALIBRATION', 'V2.3 NATURAL MATERIAL EVENTS')
text = text.replace('V2.2 Event Color', 'V2.3 Natural Events')
text = text.replace('事件综合色彩', '自然事件综合色彩')
text = text.replace('继续校准综合色域、石材和土坯夹杂', '继续校准综合色域、石材层理和土坯夹杂')
path.write_text(text, encoding='utf-8')

# ---------------------------------------------------------------------------
# Version and QA contracts remain fail-closed on manual visual approval.
# ---------------------------------------------------------------------------
path = ROOT / 'VERSION.json'
version = json.loads(path.read_text(encoding='utf-8'))
version['version'] = '2.3.0-alpha.1'
version['status'] = 'natural-material-event-calibration-alpha'
version['engineLineage']['materialGeometryEngine'] = '2.3.0-alpha.1'
version['engineLineage']['releaseMeaning'] = 'Natural broad material patches, sparse oxidation events, muted stone relationships, reduced micro-noise, and varied adobe fiber aging.'
version['engineLineage']['gaeaKernel'] = '1.2.0'
version['capabilities']['gaeaKernel'] = '1.2.0'
version['capabilities']['connectedColorNetworksSuppressed'] = True
version['capabilities']['naturalStonePalette'] = True
version['capabilities']['familySpecificSaturation'] = True
version['capabilities']['broadMaterialEventPatches'] = True
version['approval']['visualStatus'] = 'pending-user-review-v2.3'
version['approval']['productionStatus'] = False
version['approval']['jrbColorReferenceApproved'] = False
version['approval']['stoneDetailApproved'] = False
version['approval']['jrbReferenceColorApproved'] = False
version['approval']['adobeInclusionApproved'] = False
path.write_text(json.dumps(version, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')

path = ROOT / 'qa/gaea-distillation-contract-v1.json'
qa = json.loads(path.read_text(encoding='utf-8'))
qa['subject'] = 'Brick Mother V2.3 natural material event graph'
qa['implementationTarget'] = '2.3.0-alpha.1'
qa['gaeaKernel'] = '1.2.0'
qa['version'] = '2.3.0-alpha.1'
qa.setdefault('visualCalibrationGates', {}).update({
    'connectedColorNetworksSuppressed': True,
    'naturalStonePalette': True,
    'familySpecificSaturation': True,
    'broadMaterialEventPatches': True,
    'sparseOxideEvents': True,
})
path.write_text(json.dumps(qa, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')

(ROOT / 'docs/BRICK_MOTHER_V2_3_NATURAL_EVENT_COLOR.md').write_text(
    '''# Brick Mother V2.3 Natural Material Event Color

V2.3 is a visual calibration pass based on the browser evidence from V2.2.

## Corrections

1. Cellular plate and separation fields no longer paint connected orange or red networks across final materials.
2. Fired clay color is organized into broad kiln patches, sparse oxidation deposits, dark cavity soot, wet cooling traces, and mineral flecks.
3. Stone uses muted cool gray, warm brown, mineral light, wet cavity, and sparse rust relationships. RockMap and strata mainly drive relief, roughness, and tonal structure.
4. Adobe fibers use age, dust, burial, and mineral variation so straw, husk, and seeds do not share one flat orange color.
5. High-frequency micro color and bump amplitudes are reduced to restore readable macro and middle-scale structure.
6. Family-specific saturation keeps stone restrained while fired clay and adobe retain richer identities.

## Approval

Automatic source and browser gates do not approve JRB reference color, stone detail, adobe inclusions, or production use. These remain manual visual decisions.
''',
    encoding='utf-8',
)

print('Brick Mother V2.3 natural event patch prepared successfully.')
