  float eventPatchC = fbmValueFast(colorWarped * 8.40 + colorSeedV * 2.91);
  float eventPatch = smoothstep(
    0.38, 0.77,
    eventPatchA * 0.52 + eventPatchB * 0.31 + eventPatchC * 0.17
  );
  float gaeaColorDriver = bmClarity(
    bmAutoLevel(
