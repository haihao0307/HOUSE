)
text = replace_once(
    text,
    '    outColor = vec4(clamp(vec3(gaea.rugged, gaea.strata, max(gaea.rockMap, gaea.microErosion)), 0.0, 1.0), 1.0);',
    '''    float fieldComposite = clamp(
      gaea.rockMap * 0.48 + gaea.strata * 0.22 + gaea.microErosion * 0.20 + gaea.flow * 0.10,
      0.0, 1.0
    );
    outColor = vec4(vec3(fieldComposite), 1.0);''',
    'natural debug field'
)
path.write_text(text, encoding='utf-8')

# ---------------------------------------------------------------------------
# Data profiles: richer fired clay, subtle stone, varied adobe inclusions.
# ---------------------------------------------------------------------------
path = ROOT / 'data/brick-material-profiles-v2.json'
data = json.loads(path.read_text(encoding='utf-8'))
data['schemaVersion'] = '2.3.0-alpha.1'
profiles = {p['id']: p for p in data['profiles']}

def set_profile(pid, low, mean, high, palette, controls, noise=None, gaea=None):
    p = profiles[pid]
    p['runtimeDNA']['colorLowSRGB'] = low
    p['runtimeDNA']['colorMeanSRGB'] = mean
    p['runtimeDNA']['colorHighSRGB'] = high
    p['paletteDNA'].update(palette)
    p['compositeDefaults'].update(controls)
    if noise:
        p['noiseDNA'].update(noise)
    if gaea:
        p['gaeaDNA'].update(gaea)

