  color = 1.0 - exp(-color * familyExposure);''',
    'family lighting exposure'
)

path.write_text(text, encoding='utf-8')


# Profiles V2.4
path = ROOT / 'data/brick-material-profiles-v2.json'
data = json.loads(path.read_text(encoding='utf-8'))
data['schemaVersion'] = '2.4.0-alpha.1'
profiles = {p['id']: p for p in data['profiles']}


def set_profile(pid, low, mean, high, palette, controls, noise=None, runtime=None, gaea=None):
    p = profiles[pid]
    p['runtimeDNA']['colorLowSRGB'] = low
    p['runtimeDNA']['colorMeanSRGB'] = mean
    p['runtimeDNA']['colorHighSRGB'] = high
    if runtime:
        p['runtimeDNA'].update(runtime)
    p['paletteDNA'].update(palette)
    p['compositeDefaults'].update(controls)
    if noise:
        p['noiseDNA'].update(noise)
    if gaea:
        p['gaeaDNA'].update(gaea)


