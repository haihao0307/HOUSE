    );
    float kilnNeutral = smoothstep(
      0.48, 0.79,
      eventPatchA * 0.44 + (1.0 - eventPatchC) * 0.32 + gaea.rockMap * 0.24
    );
    float oxideEvent = smoothstep(
      0.64, 0.86,
      oxideMask * 0.46 + kilnFine * 0.20 + eventPatch * 0.17 +
