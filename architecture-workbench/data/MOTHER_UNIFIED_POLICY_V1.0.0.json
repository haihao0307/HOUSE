  "adoption": {
    "requiredReceipt": ["motherId", "repository", "branch", "commit", "policyVersion", "policySha256", "schemaSha256", "validatorSha256", "runtimeEntryPoints", "tests", "evidence", "unresolvedItems"],
    "claimIntegratedWithoutReceipt": false,
    "existingApprovedAssetsMayBeRegeneratedAutomatically": false,
    "coreVersionMismatch": "block_and_report"
  }
