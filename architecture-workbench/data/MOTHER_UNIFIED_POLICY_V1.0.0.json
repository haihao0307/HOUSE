  "approvals": {
    "defaultVisualApproved": false,
    "defaultProductionApproved": false,
    "assistantMaySelfGrantHumanApproval": false,
    "approvalRequiresUserRecordAndExactBuild": true,
    "materialChangesInvalidateAffectedApproval": true
