{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/yunnan-timber-member.schema.json",
  "title": "Yunnan Timber Procedural Member v0.4.0",
  "type": "object",
  "required": [
    "memberId",
    "sourceTimberId",
    "presetId",
    "profile",
    "geometryLengthAxis",
    "radialAxisHint"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "minLength": 1
    },
    "sourceTimberId": {
      "type": "string",
      "minLength": 1
    },
    "presetId": {
      "enum": [
        "dark_aged",
        "warm_medium",
        "light_weathered",
        "lacquered_chestnut"
      ]
    },
    "geometryLengthAxis": {
      "$ref": "#/$defs/vec3"
    },
    "radialAxisHint": {
      "$ref": "#/$defs/vec3"
    },
    "grainOffset": {
      "$ref": "#/$defs/vec3"
    },
    "weathering": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "toolMarks": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.8
    },
    "qualityCap": {
      "enum": [
        "building",
        "close",
        "inspection"
      ]
    },
    "profile": {
      "enum": [
        "rectangular",
        "round",
        "plank"
      ]
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": true
}
