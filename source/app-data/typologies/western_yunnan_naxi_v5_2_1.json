  "environmentalReasoning": [
    {
      "topic": "沿山势和水系",
      "explanation": "丽江传统聚落沿地形布置，水系属于场地组织的一部分，因此建筑坐标要保存坡度和水沟。",
      "authority": "UNESCOCorroborated"
    },
    {
      "topic": "木构与院落",
      "explanation": "两层瓦顶木构房屋、院落、照壁和雕刻屋梁共同形成纳西住宅的可识别层。",
      "authority": "UNESCOCorroborated"
    },
    {
      "topic": "厦子",
      "explanation": "檐下外廊将室内、庭院、雨水和日常活动连接起来，具体步架由建筑形式控制。",
      "authority": "userEvidence"
    },
    {
      "topic": "悬山",
      "explanation": "屋面越过山墙形成悬山识别特征，出挑距离必须由剖面或模型校准。",
      "authority": "userEvidence"
    },
    {
      "topic": "抗震",
      "explanation": "木构架和榫卯节点需要作为可变形连接表示，围护墙与木架接口单独验算。",
      "authority": "researchCorroborated"
    }
  ],
