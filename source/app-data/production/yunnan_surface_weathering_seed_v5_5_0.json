  "roofSurfaceSchema": {
    "channels": {
      "baseFiringTone": {
        "range": [0, 1],
        "spatialScaleM": 3.2,
        "correlation": "roof-unit-low-frequency",
        "description": "烧成综合色，控制冷灰、暖灰、褐灰、青灰家族"
      },
      "orientationExposure": {
        "range": [0, 1],
        "inputs": ["roofNormal", "sunDirection", "roofUnitId"],
        "description": "坡面朝向和长期日晒造成的褪色与干燥差异"
      },
      "dust": {
        "range": [0, 1],
        "inputs": ["slope", "ridgeDistance", "eaveDistance", "shelter"],
        "description": "低坡、脊后、檐口遮蔽和凹部积尘"
      },
      "moss": {
        "range": [0, 1],
        "inputs": ["orientationExposure", "moisture", "drainageShadow", "repairAge"],
        "description": "长期湿润且日照弱的连续苔痕区域"
      },
      "rainWash": {
        "range": [0, 1],
        "inputs": ["slopeDirection", "flowAccumulation", "eaveDistance"],
        "description": "沿坡向形成的冲刷和综合色减淡"
      },
      "damage": {
        "range": [0, 0.35],
        "correlation": "clustered-not-independent",
        "description": "少量缺瓦、崩边和局部塌损，按片区聚集"
      },
      "repair": {
        "range": [0, 0.35],
        "correlation": "bounded-patches",
        "description": "不同年代修补瓦形成边界清楚的连续片区"
      },
      "repairAgeTone": {
        "range": [-0.25, 0.25],
        "description": "修补瓦与旧瓦之间的综合色偏差"
      },
      "edgeWear": {
        "range": [0, 1],
        "inputs": ["eaveDistance", "ridgeDistance", "exposure"],
        "description": "檐口和脊部的崩边、磨损与积尘差异"
      }
    },
    "prohibited": [
      "整座建筑统一纯灰",
      "每片瓦完全独立随机色",
      "高对比白噪声覆盖整个屋面",
      "苔痕与湿度、朝向和排水无关",
      "缺瓦均匀散布",
      "修补瓦无边界随机出现"
    ],
