  "admittedRules": {
    "roofMassHierarchy": {
      "status": "required",
      "rule": "正房、耳房、倒座、门楼、大厦与小厦必须保存为独立屋面单元，各自拥有屋脊、檐口、坡向、出檐和排水目标。",
      "reason": "三个参考资产共同显示云南院落屋顶由多级屋面群构成，统一大屋面会破坏真实层级。"
    },
    "roofStaggering": {
      "status": "required",
      "rule": "屋脊和檐口高低关系由平面单体等级、楼层标高与控制剖面推导；禁止用无依据随机抬高制造错落。",
      "parameters": [
        "ridgeElevationByBuildingUnit",
        "eaveElevationByBuildingUnit",
        "overlapOrder",
        "courtyardFacingSlope",
        "outerFacingSlope"
      ]
    },
    "visibleRoofBuildUp": {
      "status": "required",
      "rule": "可见屋面厚度拆分为椽列、椽上基层、板瓦、筒瓦、檐口端件和脊部构件；不得以单一厚板代替。",
      "unresolved": [
        "各地泥背或望板实际厚度",
        "板瓦纵向搭接",
        "筒瓦压缝宽度",
        "普通住宅脊部封闭节点"
      ]
    },
    "tileColorField": {
      "status": "required",
      "rule": "瓦色由烧成基础色、朝向、积尘、苔痕、雨蚀、破损和修补层叠加；同一屋面内采用低频连续变化与少量局部异常。",
      "channels": [
        "baseFiringTone",
        "orientationExposure",
        "dustAccumulation",
        "biologicalGrowth",
        "rainWash",
        "damage",
        "repair"
      ],
      "prohibited": [
        "整栋统一纯灰",
        "高对比随机噪点",
        "每片瓦完全独立随机色"
      ]
    },
    "roofSurfaceRelief": {
      "status": "required",
      "rule": "近景使用真实瓦件几何与法线细节，远景保持相同拓扑的简化表现；屋面微曲和檐口曲线由屋架与椽列控制。",
      "qualityTiers": [
        "research_high",
        "web_standard",
        "distance_simplified"
      ]
    },
    "wallMaterialStack": {
      "status": "required",
      "rule": "墙体表现分为主体、表层、墙脚、转角保护、雨蚀、剥落和修补层；各层可以按地区和年代独立启用。",
      "layers": [
        "structuralCoreCandidate",
        "surfaceFinish",
        "stoneOrBrickPlinth",
        "cornerProtection",
        "dampBand",
        "rainWash",
        "surfaceLoss",
        "repairPatch"
      ]
    },
    "wallColorVariation": {
      "status": "required",
      "rule": "墙面色彩以大尺度材料区和垂直水蚀为主，叠加低强度颗粒与修补色差；禁止均匀单色和满墙高频噪声。"
    },
    "evidenceAdmission": {
      "status": "required",
      "rule": "扫描曲面只直接支持可见外观、颜色、粗糙度、风化和大尺度几何关系；精确构造必须由测绘、节点图或明确分件支持。",
      "classes": [
        "semantic-component-evidence",
        "grouped-scanned-surface-evidence",
        "scanned-surface-evidence",
        "texture-only-evidence",
        "unresolved"
      ]
    }
